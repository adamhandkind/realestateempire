// Cloudflare Worker for Real Estate Empire: the game files plus /api.
// First-time setup is in docs/superpowers/plans/2026-11-09-city-phase-2-accounts-and-cloud.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "real-estate-empire",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The Vite build. Every path except /api/* is served straight from here,
  // with unknown paths falling back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "real-estate-empire",
      // Replace with the id `wrangler d1 create real-estate-empire` prints.
      // Local dev (`wrangler dev`) works with this placeholder.
      "database_id": "f5bbc639-db9f-4da3-9027-caba4ddbca32",
      "migrations_dir": "migrations"
    }
  ],

  // One Durable Object per city: the live game, its feed and the nightly
  // tick (an alarm). SQLite-backed, so a city's storage is generous.
  "durable_objects": {
    "bindings": [{ "name": "CITY", "class_name": "CityObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CityObject"] }],

  // Production settings. Secrets (RESEND_API_KEY) go in with
  // `wrangler secret put`, never here.
  "vars": {
    "APP_URL": "https://real-estate-empire.example.workers.dev",
    "OWNER_EMAILS": "adam@handkindconstruction.ca",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "Real Estate Empire <login@example.com>"
  },

  // `wrangler dev` reads overrides from .dev.vars (see .dev.vars.example).
}
