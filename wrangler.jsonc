// Cloudflare Worker for Real Estate Empire: the game files plus /api.
// First-time setup is in docs/superpowers/plans/2026-11-09-city-phase-2-accounts-and-cloud.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "real-estate-empire",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The Vite build. Every path except /api/* is served straight from here,
  // with unknown paths falling back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "real-estate",
      // The id `wrangler d1 create real-estate` printed.
      // Local dev (`wrangler dev`) works with this placeholder.
      "database_id": "f5bbc639-db9f-4da3-9027-caba4ddbca32",
      "migrations_dir": "migrations"
    }
  ],

  // One Durable Object per city: the live game, its feed and the nightly
  // tick (an alarm). SQLite-backed, so a city's storage is generous.
  // PARTY is a Land Grab party room, one per room code.
  "durable_objects": {
    "bindings": [
      { "name": "CITY", "class_name": "CityObject" },
      { "name": "PARTY", "class_name": "PartyObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CityObject"] },
    { "tag": "v2", "new_sqlite_classes": ["BoardObject"] },
    { "tag": "v3", "new_sqlite_classes": ["PartyObject"] },
    // The old per-city Land Grab table, replaced by party rooms.
    { "tag": "v4", "deleted_classes": ["BoardObject"] }
  ],

  // Land Grab party rooms can be joined without an account, so the open
  // routes are limited per IP. A whole party shares one Wi-Fi address, so
  // this is generous: it only stops someone hammering codes.
  "ratelimits": [
    { "name": "PARTY_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  // Production settings. Nothing is emailed: players join with invite links
  // and the owner signs in with `npm run login-link`.
  "vars": {
    "APP_URL": "https://realestateempire.adam-434.workers.dev",
    "OWNER_EMAILS": "adam@handkindconstruction.ca"
  },

  // `wrangler dev` reads overrides from .dev.vars (see .dev.vars.example).
}
