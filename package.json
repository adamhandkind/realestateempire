{
  "name": "real-estate-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "dev:api": "wrangler d1 migrations apply real-estate-empire --local && wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply real-estate-empire --remote",
    "deploy": "npm run build && wrangler d1 migrations apply real-estate-empire --remote && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
